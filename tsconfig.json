{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/e2e-34420/types/**/*.ts",
    ".next/e2e-34420/dev/types/**/*.ts",
    ".next/e2e-33292/types/**/*.ts",
    ".next/e2e-33292/dev/types/**/*.ts",
    ".next/e2e-4284/types/**/*.ts",
    ".next/e2e-4284/dev/types/**/*.ts",
    ".next/e2e-30304/types/**/*.ts",
    ".next/e2e-30304/dev/types/**/*.ts",
    ".next/e2e-27744/types/**/*.ts",
    ".next/e2e-27744/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report"
  ]
}
