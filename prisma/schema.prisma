generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/**
 * ----------------------------- Enums -----------------------------
 */

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum TransactionPurpose {
  BASE_BOOKING
  EXTENSION
  ADDITIONAL_CHARGE
}

enum ReservationStatus {
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ExtensionRequestStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  PAYMENT_REVIEW_REQUIRED
}

enum AdditionalChargeType {
  SERVICE
  DAMAGE
}

enum AdditionalChargeStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REJECTED
  PAYMENT_REVIEW_REQUIRED
}

enum ReservationChatMessageKind {
  USER
  SYSTEM
}

enum ListingStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum AdditionalSetPricingType {
  FIXED
  HOURLY
}

enum ListingType {
  STANDARD
  CURATED
}

enum InvoiceDocumentType {
  CUSTOMER_STUDIO_TAX_INVOICE
  CUSTOMER_ARKANET_TAX_INVOICE
  OWNER_MONTHLY_COMMISSION_INVOICE
  OWNER_MONTHLY_BILL_OF_SUPPLY
}

enum InvoicePartyType {
  CUSTOMER
  OWNER
  STUDIO
  ARKANET
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  STORED
  EMAIL_PENDING
  EMAIL_SENT
  EMAIL_FAILED
  RETRYING
  DELIVERY_BLOCKED
}

enum PaymentVoucherType {
  RECEIPT_VOUCHER
  REFUND_VOUCHER
}

enum PaymentVoucherStatus {
  GENERATED
  STORED
  EMAIL_PENDING
  EMAIL_SENT
  EMAIL_FAILED
  RETRYING
  DELIVERY_BLOCKED
}

/**
 * ---------------------------- Models -----------------------------
 */

model User {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId
  name                    String?
  email                   String?           @unique
  phone                   String?
  languages               String[]          @default([])
  location                String?
  description             String?
  profileImage            String?
  title                   String?
  emailVerified           DateTime?
  image                   String?
  hashedPassword          String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  emailVerificationCodeHash   String?
  emailVerificationCodeExpiry DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  favoriteIds             String[]          @db.ObjectId
  accounts                Account[]
  listings                Listing[]
  reservations            Reservation[]
  chatMessages            ReservationChatMessage[]
  CustomAmenities         CustomAmenities[]
  Review                  Review[]
  reviewsAdded            Review[]          @relation("ReviewAddedBy")
  paymentDetails          PaymentDetails?   @relation("UserPaymentDetails")
  paymentDetailsId        String?           @db.ObjectId
  role                    UserRole          @default(CUSTOMER)
  is_verified             Boolean           @default(false)
  transactions            Transaction[]
  googleCalendarConnected Boolean           @default(false)
  billingDetails          BillingDetails[]
  invoices                Invoice[]
  paymentVouchers         PaymentVoucher[]
  markedForDeletion       Boolean           @default(false)
  markedForDeletionAt     DateTime?

  verification_stage Int       @default(0) // 0=none, 1=contact, 2=aadhaar, 3=bank
  aadhaar_verified   Boolean   @default(false)
  aadhaar_ref_id     String?
  bank_verified      Boolean   @default(false)
  bank_verified_name String?
  phone_verified     Boolean   @default(false)
  email_verified     Boolean   @default(false)
  verified_via       String[]  @default([])
  verified_at        DateTime?
  aadhaar_last4      String?
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Listing {
  id                       String                    @id @default(auto()) @map("_id") @db.ObjectId
  title                    String
  slug                     String?                   @unique
  description              String
  imageSrc                 String[]
  createdAt                DateTime                  @default(now())
  category                 String
  locationValue            String
  actualLocation           Json?
  propertyStateCode        String?
  userId                   String                    @db.ObjectId
  price                    Int?
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations             Reservation[]
  amenities                String[]
  otherAmenities           String[]
  addons                   Json?
  carpetArea               Int?
  operationalDays          Json?
  operationalHours         Json?
  minimumBookingHours      Int?
  maximumPax               Int?
  instantBooking           Boolean?
  type                     String[]
  verifications            Json?
  terms                    Boolean?
  customTerms              String?

  reviews                  Review[]
  DayStatus                DayStatus[]
  avgReviewRating          Float?
  Transaction              Transaction[]
  packages                 Package[]
  status                   ListingStatus             @default(PENDING)
  active                   Boolean                   @default(false)
  accountDeactivatedAt     DateTime?
  reviewedAt               DateTime?
  reviewedById             String?                   @db.ObjectId
  rejectionReason          String?
  hasSets                  Boolean                   @default(false)
  setsHaveSamePrice        Boolean                   @default(false)
  unifiedSetPrice          Int?
  additionalSetPricingType AdditionalSetPricingType?

  // Taxonomy axes — studio-level
  venueTypes               String[]                  @default([]) // axis 2 (replaces category; category kept for back-compat migration)
  aesthetics               String[]                  @default([]) // axis 3 (mirror of set-level for simple studios)
  setFeatures              String[]                  @default([]) // axis 4a (mirror of set-level for simple studios)

  sets                     ListingSet[]
  videoSrc                 String?

  blocks                   ListingBlock[]

  // Curated listing fields
  listingType              ListingType               @default(STANDARD)
  curatedSource            String?
  contactEmail             String?
  mapsUrl                  String?
  websiteUrl               String?
  instagramHandle          String?
  priceRangeMin            Int?
  priceRangeMax            Int?
  notifyEmailSentAt        DateTime?
  notifyReminderAt         DateTime?
  inConversation           Boolean                   @default(false)
  enquiryCount             Int                       @default(0)

  @@index([userId])
  @@index([listingType])
  @@index([listingType, status, createdAt])
  @@index([active, status, createdAt])
}

model Package {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String?
  originalPrice    Int
  offeredPrice     Int
  features         String[]
  durationHours    Int
  requiredSetCount Int?

  fixedAddOn       Int?
  eligibleSetIds   String[] @db.ObjectId
  isActive         Boolean  @default(true)
  listingId        String   @db.ObjectId
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model DayStatus {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  date          DateTime
  listingActive Boolean
  startTime     String
  endTime       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listingId     String   @db.ObjectId
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
}

model Reservation {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  userId              String          @db.ObjectId
  listingId           String          @db.ObjectId
  bookingId           String          @unique
  startDate           DateTime        @default(now())
  startTime           String
  endTime             String
  totalPrice          Float
  selectedAddons      Json?
  createdAt           DateTime        @default(now())
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing             Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  Review              Review[]
  isApproved          Int?
  status              ReservationStatus @default(PENDING_APPROVAL)
  checkedInAt         DateTime?
  completedAt         DateTime?
  noShowAt            DateTime?
  refundAmount        Int?
  refundRecordedAt    DateTime?
  refundNote          String?
  extensionNudgeSentAt DateTime?
  rejectReason        String?
  Transaction         Transaction[]
  extensionRequests   ExtensionRequest[]
  additionalCharges   AdditionalCharge[]
  chatMessages        ReservationChatMessage[]
  invoices            Invoice[]
  paymentVouchers     PaymentVoucher[]
  billingDetailId     String?         @db.ObjectId
  billingDetail       BillingDetails? @relation(fields: [billingDetailId], references: [id])
  billingSnapshot      Json?
  markedForDeletion   Boolean         @default(false)
  markedForDeletionAt DateTime?
  setIds              String[]        @db.ObjectId
  includedSetId       String?         @db.ObjectId
  setPackageId        String?         @db.ObjectId
  pricingSnapshot     Json?
  totalPriceInt       Int?
  reminderSent        Boolean         @default(false)
  reviewReminderSentAt DateTime?
  reviewReminderClaimedAt DateTime?
  reviewReminderAttempts Int           @default(0)

  unreadCountOwner Int @default(0)
  unreadCountGuest Int @default(0)

  lastMessageText String?
  lastMessageAt   DateTime?

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([billingDetailId])
  @@index([startDate])
  @@index([status])
  @@index([checkedInAt])
  @@index([completedAt])
  @@index([status, completedAt])
  @@index([reviewReminderSentAt])
}

model ReservationSlot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId     String   @db.ObjectId
  reservationId String   @db.ObjectId
  dateKey       String
  slotKey       String
  setId         String
  createdAt     DateTime @default(now())

  @@unique([listingId, dateKey, slotKey, setId])
  @@index([reservationId])
  @@index([listingId, dateKey])
}

model Amenities {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  icon      Json?
  createdAt DateTime @default(now())
}

model CustomAmenities {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([userId])
}



enum ReviewSource {
  PLATFORM
  WHATSAPP
}

model Review {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  // Absent on pre-existing records — treat as PLATFORM in application code.
  // No `@default` here: Mongo doesn't backfill defaults onto documents that
  // predate this field, so a required enum would fail to deserialize them.
  source        ReviewSource?
  userId        String?       @db.ObjectId
  listingId     String        @db.ObjectId
  reservationId String?       @db.ObjectId
  rating        Float?
  comment       String
  createdAt     DateTime      @default(now())
  // WHATSAPP-sourced reviews have no platform account behind them.
  guestName     String?
  guestRole     String?
  // Admin who transcribed a WHATSAPP review.
  addedById     String?       @db.ObjectId
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  addedBy       User?         @relation("ReviewAddedBy", fields: [addedById], references: [id])

  @@index([userId])
  @@index([listingId])
  @@index([reservationId])
  @@unique([reservationId, userId])
}

model PaymentDetails {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String   @unique @db.ObjectId
  accountHolderName       String
  bankName                String
  accountNumber           String
  ifscCode                String
  companyName             String?
  gstin                   String?
  cashfreeVendorId        String?
  accountNumberIV         String?
  ifscCodeIV              String?
  gstinIV                 String?
  vendorIdIV              String?
  encryptionVersion       String?  @default("v1")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation("UserPaymentDetails", fields: [userId], references: [id])
}


model BillingDetails {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  companyName    String
  gstin          String // removed @db.VarChar
  billingAddress String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  reservations Reservation[]
  invoices     Invoice[]

  @@unique([userId, gstin])
  @@index([userId])
}

model Transaction {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  userId        String            @db.ObjectId
  reservationId String?           @db.ObjectId
  listingId     String?           @db.ObjectId
  bookingId     String?
  amount        Float
  currency      String            @default("INR")
  status        TransactionStatus @default(PENDING)
  purpose       TransactionPurpose @default(BASE_BOOKING)
  description   String?
  paymentMethod String            @default("Cashfree")
  invoices      Invoice[]
  paymentVouchers PaymentVoucher[]
  extensionRequestId String?       @db.ObjectId
  additionalChargeId String?       @db.ObjectId

  // -------- Cashfree PG fields ----------
  cfOrderId            String?
  cfPaymentId          String?
  cfTxnRef             String?
  cfPaymentSessionId   String?
  cfWebhookPayload     Json?
  cfSignature          String?
  emailSentCustomer    Boolean   @default(false)
  emailSentOwner       Boolean   @default(false)
  emailSentFailed      Boolean   @default(false)
  whatsappSentCustomer Boolean   @default(false)
  whatsappSentHost     Boolean   @default(false)
  emailSentApprovalCustomer Boolean @default(false)
  emailSentRejectionCustomer Boolean @default(false)
  emailSentCancellationHost Boolean @default(false)
  whatsappSentApprovalCustomer Boolean @default(false)
  whatsappSentRejectionCustomer Boolean @default(false)
  whatsappSentCancellationHost Boolean @default(false)
  vendorId             String?
  payoutAmountToOwner  Float?
  payoutPercentToOwner Float?    @default(88)
  payoutDueAt          DateTime?
  payoutSplitAt        DateTime?
  payoutDoneAt         DateTime?
  
  // -------- GST Handling ----------
  gstOwnedBy           String?   @default("STUDIO") // "STUDIO" or "ARKANET"
  baseAmountBeforeGst  Float?    // Amount before GST (for calculation clarity)

  // -------- Common ----------
  customerPhone String?
  customerEmail String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  listing     Listing?     @relation(fields: [listingId], references: [id])
  extensionRequest ExtensionRequest? @relation(fields: [extensionRequestId], references: [id])
  additionalCharge AdditionalCharge? @relation(fields: [additionalChargeId], references: [id])

  @@index([userId])
  @@index([reservationId])
  @@index([listingId])
  @@index([extensionRequestId])
  @@index([additionalChargeId])
  @@index([purpose])
  @@index([status])
  @@index([payoutDueAt])
  @@index([payoutSplitAt])
}

model ExtensionRequest {
  id                String                 @id @default(auto()) @map("_id") @db.ObjectId
  reservationId     String                 @db.ObjectId
  reservation       Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  durationMinutes   Int
  oldEndTime        String
  requestedEndTime  String
  extraAmount       Int
  listingRateAtTime Int?
  status            ExtensionRequestStatus @default(PENDING_PAYMENT)
  cfOrderId         String?
  cfPaymentId       String?
  paymentTokenHash  String?
  expiresAt         DateTime
  paidAt            DateTime?
  appliedAt         DateTime?
  cancelledAt       DateTime?
  expiredAt         DateTime?
  failureReason     String?
  transactions      Transaction[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([reservationId])
  @@index([status])
  @@index([expiresAt])
  @@index([paymentTokenHash])
}

model AdditionalCharge {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  reservationId    String                 @db.ObjectId
  reservation      Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type             AdditionalChargeType
  items            Json
  totalAmount      Int
  note             String?
  status           AdditionalChargeStatus @default(PENDING_PAYMENT)
  cfOrderId        String?
  cfPaymentId      String?
  paymentTokenHash String?
  paidAt           DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  failureReason    String?
  transactions     Transaction[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([reservationId])
  @@index([type])
  @@index([status])
  @@index([paymentTokenHash])
}

model ReservationChatMessage {
  id            String                     @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String                     @db.ObjectId
  reservation   Reservation                @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  senderId      String?                    @db.ObjectId
  sender        User?                      @relation(fields: [senderId], references: [id])
  kind          ReservationChatMessageKind @default(USER)
  text          String
  createdAt     DateTime                   @default(now())

  @@index([reservationId, createdAt])
  @@index([senderId])
}

model Invoice {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber  String              @unique
  userId         String              @db.ObjectId
  reservationId  String?             @db.ObjectId
  transactionId  String?             @db.ObjectId
  billingId      String?             @db.ObjectId
  amount         Float
  gstAmount      Float?
  totalAmount    Float
  taxableValue   Float?
  cgstRate       Float?
  cgstAmount     Float?
  sgstRate       Float?
  sgstAmount     Float?
  igstRate       Float?
  igstAmount     Float?
  invoiceUrl     String
  documentType   InvoiceDocumentType @default(CUSTOMER_ARKANET_TAX_INVOICE)
  issuerType     InvoicePartyType    @default(ARKANET)
  recipientType  InvoicePartyType    @default(CUSTOMER)
  financialYear  String?
  periodStart    DateTime?
  periodEnd      DateTime?
  issuedAt       DateTime?
  generatedAt    DateTime?
  storedAt       DateTime?
  emailSentAt    DateTime?
  sequence       Int?
  idempotencyKey String?
  status         InvoiceStatus       @default(STORED)
  emailError     String?
  retryCount     Int                 @default(0)
  lineItems      Json?
  totals         Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  reservation    Reservation?    @relation(fields: [reservationId], references: [id])
  transaction    Transaction?    @relation(fields: [transactionId], references: [id])
  billingDetails BillingDetails? @relation(fields: [billingId], references: [id])

  @@index([userId])
  @@index([reservationId])
  @@index([transactionId])
  @@index([documentType])
  @@index([status])
  @@index([idempotencyKey])
  @@index([periodStart, periodEnd])
}

model InvoiceSequence {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  scopeKey      String   @unique
  financialYear String
  series        String
  ownerId       String?  @db.ObjectId
  nextNumber    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([financialYear, series])
}

model InvoiceIdempotencyLock {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}

model PaymentVoucher {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  voucherNumber   String               @unique
  userId          String               @db.ObjectId
  reservationId   String?              @db.ObjectId
  transactionId   String?              @db.ObjectId
  linkedVoucherId String?              @db.ObjectId
  amount          Float
  voucherUrl      String
  voucherType     PaymentVoucherType
  financialYear   String
  issuedAt        DateTime?
  generatedAt     DateTime?
  storedAt        DateTime?
  emailSentAt     DateTime?
  sequence        Int
  idempotencyKey  String               @unique
  status          PaymentVoucherStatus @default(GENERATED)
  emailError      String?
  retryCount      Int                  @default(0)
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  reservation     Reservation?         @relation(fields: [reservationId], references: [id])
  transaction     Transaction?         @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([reservationId])
  @@index([transactionId])
  @@index([voucherType])
  @@index([status])
  @@index([financialYear, voucherType])
}

model PaymentVoucherSequence {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  scopeKey      String   @unique
  financialYear String
  series        String
  nextNumber    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([financialYear, series])
}

model PaymentVoucherIdempotencyLock {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ListingSet {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId   String   @db.ObjectId
  name        String
  description String?
  images      String[]
  price       Int      @default(0)
  position    Int      @default(0)
  aesthetics  String[] @default([]) // axis 3 — per-set aesthetic tags
  setFeatures String[] @default([]) // axis 4a — per-set physical features
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}



model ListingBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @db.ObjectId
  date      DateTime
  startTime String
  endTime   String
  setIds    String[] @db.ObjectId
  reason    String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, date])
}

