# EditorConfig matches files at any level in a directory tree.
root = true

# Define standard configurations for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files can contain trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false

# Web assets, styles and config file standards
[*.{json,yml,yaml}]
indent_size = 2

# package.json and workspace configuration files specifically
[package.json]
indent_style = tab
indent_size = 4
