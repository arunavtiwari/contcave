# E2E runs are destructive. Use a dedicated non-production database name.
E2E_ALLOW_STAGING_WRITES=true
E2E_BASE_URL=http://localhost:3000
E2E_DATABASE_URL=mongodb+srv://user:password@example.mongodb.net/
E2E_DATABASE_NAME=contcave_e2e
E2E_EXPECTED_DATABASE_NAME=contcave_e2e
E2E_ALLOWED_DATABASE_NAMES=contcave_e2e
E2E_EMAIL_DOMAIN=example.test
E2E_TEST_CUSTOMER_EMAIL=
E2E_TEST_OWNER_EMAIL=
E2E_TEST_CUSTOMER_PHONE=
E2E_TEST_OWNER_PHONE=
E2E_BANK_ACCOUNT_NUMBER=123456789012
E2E_BANK_IFSC=HDFC0001234
E2E_BANK_NAME=Test Bank
E2E_BANK_HOLDER=Test Owner
E2E_CASHFREE_PAYMENT_METHOD={"type":"upi","vpa":"success@upi"}
E2E_START_LOCAL_SERVER=true
E2E_INCLUDE_SERVER_MODULE_SPECS=true
E2E_USE_REAL_CASHFREE=false
E2E_DISABLE_CASHFREE_REFUND=true
E2E_DISABLE_EMAIL_SEND=true
E2E_DISABLE_WHATSAPP_SEND=true
E2E_DISABLE_R2_UPLOAD=true
# Local QStash emulator
QSTASH_DEV=true
QSTASH_URL=http://127.0.0.1:8080
QSTASH_DESTINATION_URL=http://localhost:3000/api/cron/qstash
E2E_DISABLE_RECURRING_QSTASH=true
