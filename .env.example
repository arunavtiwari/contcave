# Authentication and application URLs
AUTH_SECRET=
NEXTAUTH_URL=https://contcave.com
APP_URL=https://contcave.com

# Database and encryption
DATABASE_URL=
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=v1

# Google OAuth, Calendar, and Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API=

# Cashfree
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_VERIFY_VENDOR_ACCOUNT=false
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Ably
ABLY_CHAT_API=

# Mailer Send
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=

# WhatsApp
NEXT_PUBLIC_SUPPORT_WHATSAPP=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Outbound proxy and operations
FIXIE_URL=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=
NEXT_PUBLIC_CLOUDFLARE_PUBLIC_URL=https://assets.contcave.com

# QStash
QSTASH_DEV=false
QSTASH_URL=
QSTASH_DESTINATION_URL=https://contcave.com/api/cron/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Concierge (AI booking assistant) — see docs/concierge.md
# Set CONCIERGE_ENABLED=false to hide the chat entirely.
CONCIERGE_ENABLED=true
# OpenAI-compatible server holding an open-source model. Leave empty to run on the rule-based fallback.
# Ollama on this machine: http://127.0.0.1:11434/v1
CONCIERGE_LLM_BASE_URL=
# Groq (hosted, free tier): https://api.groq.com/openai/v1
# Only for hosted endpoints (Groq, Together, OpenRouter); Ollama needs none.
CONCIERGE_LLM_API_KEY=
# Must support tool calling. Ollama: qwen3:4b-instruct. Groq: openai/gpt-oss-120b
CONCIERGE_MODEL=qwen3:4b-instruct
# Output-limit field name: max_tokens (Ollama, vLLM) or max_completion_tokens (Groq, OpenAI).
CONCIERGE_LLM_TOKEN_PARAM=max_tokens
# Extra request fields as JSON. Groq GPT-OSS: {"reasoning_effort":"low","include_reasoning":false}
CONCIERGE_LLM_EXTRA=
# Raise for models that reason before answering (Groq GPT-OSS: 700 and 2000).
# Models to try, in order, when the main one is rate-limited (Groq: openai/gpt-oss-20b).
CONCIERGE_MODEL_FALLBACKS=
CONCIERGE_MAX_TOKENS=900
CONCIERGE_PLANNER_MAX_TOKENS=1800
# Optional larger model used only for drafting shoot plans; defaults to CONCIERGE_MODEL.
CONCIERGE_PLANNER_MODEL=
# Ops CRM link (contcave-crm service token); leave empty to switch the sync off.
CRM_BASE_URL=
CRM_SERVICE_TOKEN=
